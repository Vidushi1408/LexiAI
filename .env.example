LEXI_OLLAMA_URL=http://localhost:11434/api/chat
LEXI_OLLAMA_MODEL=llama3.2:3b
LEXI_LLM_TIMEOUT=120
LEXI_LLM_RETRIES=2
LEXI_LLM_TEMPERATURE=0.3
LEXI_MIN_RELEVANCE=0.3
LEXI_AUDIT_LOG_QUERIES=0
LEXI_ZERO_RETENTION=0
LEXI_AUTH_ENABLED=1
LEXI_MAX_UPLOAD_MB=25
LEXI_MAX_AUDIO_MB=100

# Flask web app
# LEXI_SECRET_KEY=          # leave unset in dev: a key is generated and persisted to data/auth/.flask_secret_key
LEXI_SESSION_COOKIE_SECURE=1 # set to 0 only for local http:// (non-TLS) development
PORT=8000

# Persistence: users, audit log, per-session knowledge-base state (M4).
# Leave unset for a zero-setup local SQLite file (./data/lexi.db). `docker compose up` sets this
# to the bundled Postgres service automatically; set it yourself for any other Postgres.
# DATABASE_URL=postgresql+psycopg://lexi:lexi@localhost:5432/lexi

# Billing (M5) — leave all unset to run without billing: /billing shows plans read-only and the
# Free plan's seat limit still applies. Get these from the Stripe dashboard (test mode to start).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...          # from the webhook endpoint's settings in Stripe
# STRIPE_PRICE_PRO=price_...               # a recurring Price for the Pro plan
# STRIPE_PRICE_ENTERPRISE=price_...        # a recurring Price for the Enterprise plan
